<div class="layout layout--col layout--center gap--small">
  <div class="flex flex--row flex--center-x flex--center-y gap">
    {% render "weather_icon", code: current.weather_code, night: night, size: 76 %}
    <span class="value value--xxlarge">{{ current.temperature_2m | round }}°</span>
  </div>
  <span class="title title--small">{% render "weather_words", code: current.weather_code %} · {{ daily.temperature_2m_max[0] | round }}° / {{ daily.temperature_2m_min[0] | round }}°</span>
  {% render "wind", speed: current.wind_speed_10m, dir: current.wind_direction_10m, gust: current.wind_gusts_10m %}
  <span class="label label--inverted rain-note">{{ summary }}</span>
</div>

<div class="title_bar">
  <span class="title">Weather</span>
  <span class="instance">{{ today_short }}</span>
</div>
