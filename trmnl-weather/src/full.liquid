<div class="wx-full">
  <div class="wx-head">
    <span class="wx-date">{{ today }}</span>
    <span class="wx-place">{{ place }}</span>
  </div>
  <div class="wx-body">
    <div class="flex flex--col flex--left gap--small wx-main">
      <div class="flex flex--row flex--left flex--center-y gap--large w--full">
        {% render "weather_icon", code: current.weather_code, night: night, size: 96 %}
        <span class="value value--xxlarge">{{ current.temperature_2m | round }}°</span>
        <div class="wx-now">
          <div class="wx-now-words">{% render "weather_words", code: current.weather_code %}</div>
          <div class="wx-now-line">Feels like <b>{{ current.apparent_temperature | round }}°</b></div>
          <div class="wx-now-line">High <b>{{ daily.temperature_2m_max[0] | round }}°</b>&nbsp;&nbsp;Low <b>{{ daily.temperature_2m_min[0] | round }}°</b></div>
          {%- assign compass = "N,NE,E,SE,S,SW,W,NW" | split: "," -%}
          {%- assign wdir = current.wind_direction_10m | default: 0 -%}
          {%- assign widx = wdir | plus: 22.5 | divided_by: 45 | floor | modulo: 8 -%}
          {%- assign toward = wdir | plus: 180 | modulo: 360 -%}
          <div class="wx-now-line"><svg class="wx-arrow" viewBox="0 0 20 20" width="0.95em" height="0.95em"><g transform="rotate({{ toward }} 10 10)"><path d="M10 2l6 14-6-4-6 4z" fill="black"/></g></svg> <b>{{ current.wind_speed_10m | round }} mph</b> {{ compass[widx] }}{% if current.wind_gusts_10m %}, gusts <b>{{ current.wind_gusts_10m | round }}</b>{% endif %}</div>
        </div>
      </div>
      <div class="wx-summary">{{ summary }}</div>
      <div class="chart-box">
        {% render "rain_temp_chart", hourly: hourly, hours: 13, w: 540, h: 258, wind_every: 2, icons_every: 1 %}
      </div>
    </div>
    <div class="wx-days--cards">
      {% render "day_card", daily: daily, i: 1, label: "Tomorrow", size: 60 %}
      {% render "day_card", daily: daily, i: 2, label: nil, size: 60 %}
      {% render "day_card", daily: daily, i: 3, label: nil, size: 60 %}
    </div>
  </div>
</div>
